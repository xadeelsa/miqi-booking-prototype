// MIQI Booking, Prisma schema. Design notes in ARCHITECTURE.md.
//
//  - Service and Slot are seeded reference data: one tutor, one calendar.
//  - schoolLevel/year/subject are captured on a booking, not join tables. The
//    option lists live in src/lib/catalog.ts, not in the database.
//  - Booking.slotId is UNIQUE. That constraint is the whole anti-double-booking
//    guarantee.
//  - Booking.priceCents is copied from the Service at booking time, so a later
//    price change never rewrites historical bookings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String
  priceCents  Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@map("services")
}

model Slot {
  id        Int      @id @default(autoincrement())
  startsAt  DateTime @unique
  endsAt    DateTime
  createdAt DateTime @default(now())
  booking   Booking?

  @@index([startsAt])
  @@map("slots")
}

model Booking {
  id        Int    @id @default(autoincrement())
  reference String @unique

  // One booking per slot, enforced by the database.
  slotId Int @unique

  serviceId Int

  // Captured selection.
  schoolLevel SchoolLevel
  year        String
  subject     String

  // Contact details.
  parentName  String
  parentEmail String
  parentPhone String?
  studentName String

  // Price snapshot + payment state.
  priceCents    Int
  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])
  slot    Slot    @relation(fields: [slotId], references: [id])

  @@index([serviceId])
  @@index([createdAt])
  @@map("bookings")
}

enum SchoolLevel {
  BASISSCHOOL
  VMBO
  HAVO
  VWO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
