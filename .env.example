# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL connection string used by Prisma.
#
# Homebrew on macOS (superuser is your macOS username, usually no password):
DATABASE_URL="postgresql://YOUR_MACOS_USER@localhost:5432/miqi_booking?schema=public"
#
# Docker / Linux / CI (user + password):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miqi_booking?schema=public"

# Admin view is open in this prototype (see README > Limitations).
# In production this would gate the /admin route.
# ADMIN_TOKEN=""

# Confirmation emails are mocked — they are written to the server log, never
# delivered. Sender address only; override if you want the log to show yours.
# EMAIL_FROM="MIQI Huiswerkbegeleiding <bookings@miqi.example>"
#
# Swapping the mock for the real Resend client is the one place a key would go.
# RESEND_API_KEY=""
